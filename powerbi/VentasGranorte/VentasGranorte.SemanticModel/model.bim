        "measures": [
          {
            "name": "Ventas",
            "expression": "SUM ( ventas[venta_neta] )",
            "formatString": "\\$ #,0",
            "displayFolder": "Base",
            "lineageTag": "118d9c9b-a8d0-49c8-8306-5222256ad959"
          },
          {
            "name": "Costo",
            "expression": "SUM ( ventas[costo_total] )",
            "formatString": "\\$ #,0",
            "displayFolder": "Base",
            "lineageTag": "2a98ba65-6e4a-4e7d-8174-2d825b264e77"
          },
          {
            "name": "Margen Bruto",
            "expression": "[Ventas] - [Costo]",
            "formatString": "\\$ #,0",
            "displayFolder": "Base",
            "lineageTag": "d8a62c0a-d370-4294-8006-f2d94e9c47ce"
          },
          {
            "name": "Margen %",
            "expression": "DIVIDE ( [Margen Bruto], [Ventas] )",
            "formatString": "0.0 %;-0.0 %;0.0 %",
            "displayFolder": "Base",
            "lineageTag": "9ec1cf59-d26d-4823-95b3-b6fc422115d2"
          },
          {
            "name": "Unidades",
            "expression": "SUM ( ventas[cantidad] )",
            "formatString": "#,0",
            "displayFolder": "Base",
            "lineageTag": "d173f01e-f0a6-4543-810b-7d133d68487b"
          },
          {
            "name": "Facturas",
            "expression": "DISTINCTCOUNT ( ventas[id_factura] )",
            "formatString": "#,0",
            "displayFolder": "Base",
            "lineageTag": "47f3937c-b4cd-4d05-b2e7-1ac94abd7edd"
          },
          {
            "name": "Ticket Promedio",
            "expression": "DIVIDE ( [Ventas], [Facturas] )",
            "formatString": "\\$ #,0",
            "displayFolder": "Base",
            "lineageTag": "ee282515-0432-4f8a-9af8-dc207a6ab50a"
          },
          {
            "name": "Clientes Activos",
            "expression": "DISTINCTCOUNT ( ventas[id_cliente] )",
            "formatString": "#,0",
            "displayFolder": "Base",
            "lineageTag": "f665f30d-bc76-415a-b419-efb06b263043"
          },
          {
            "name": "Venta Bruta",
            "expression": "SUMX ( ventas, ventas[cantidad] * ventas[precio_unitario] )",
            "formatString": "\\$ #,0",
            "displayFolder": "Base",
            "lineageTag": "d28a7be2-b779-46c6-8e8a-1135c1205c68"
          },
          {
            "name": "Descuento %",
            "expression": "DIVIDE ( [Venta Bruta] - [Ventas], [Venta Bruta] )",
            "formatString": "0.0 %;-0.0 %;0.0 %",
            "displayFolder": "Base",
            "lineageTag": "e8d6bcf8-4d31-42a3-b28d-d42b9988a34b"
          },
          {
            "name": "Ventas AA",
            "expression": "CALCULATE ( [Ventas], SAMEPERIODLASTYEAR ( Calendario[Fecha] ) )",
            "formatString": "\\$ #,0",
            "displayFolder": "Comparación",
            "lineageTag": "5df8eb0f-9cb6-4db0-a260-f0aa3852c860"
          },
          {
            "name": "Var % Ventas AA",
            "expression": "DIVIDE ( [Ventas] - [Ventas AA], [Ventas AA] )",
            "formatString": "+0.0 %;-0.0 %;0.0 %",
            "displayFolder": "Comparación",
            "lineageTag": "77466eb5-324e-4585-934a-72fd066b88c4"
          },
          {
            "name": "Margen % AA",
            "expression": "CALCULATE ( [Margen %], SAMEPERIODLASTYEAR ( Calendario[Fecha] ) )",
            "formatString": "0.0 %;-0.0 %;0.0 %",
            "displayFolder": "Comparación",
            "lineageTag": "e52487f2-674e-4d8d-bb61-b20e014d5717"
          },
          {
            "name": "Var Margen (pp)",
            "expression": "( [Margen %] - [Margen % AA] ) * 100",
            "formatString": "+0.0 \"pp\";-0.0 \"pp\"",
            "displayFolder": "Comparación",
            "lineageTag": "5b99bdfc-5e47-4aa1-afb1-1420c5a2b036"
          },
          {
            "name": "Ventas (año actual)",
            "expression": "VAR a = YEAR ( CALCULATE ( MAX ( ventas[fecha] ), ALL ( ventas ), ALL ( Calendario ) ) ) RETURN CALCULATE ( [Ventas], Calendario[Año] = a )",
            "formatString": "\\$ #,0",
            "displayFolder": "Año actual",
            "lineageTag": "10fd71f9-24be-4841-8285-055d043931d2"
          },
          {
            "name": "Var % Ventas (año actual)",
