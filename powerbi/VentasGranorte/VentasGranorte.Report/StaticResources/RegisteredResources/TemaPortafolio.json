{
  "name": "TemaPortafolio",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#898781",
  "background": "#fcfcfb",
  "backgroundLight": "#f9f9f7",
  "backgroundNeutral": "#e1e0d9",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#184f95",
  "center": "#86b6ef",
  "minimum": "#f4f8fd",
  "textClasses": {
    "title": {"fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b"},
    "header": {"fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0b0b0b"},
    "label": {"fontFace": "Segoe UI", "fontSize": 10, "color": "#52514e"},
    "callout": {"fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#0b0b0b"}
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{"show": true, "color": {"solid": {"color": "#fcfcfb"}}}],
        "border": [{"show": false}],
        "valueAxis": [{"gridlineColor": {"solid": {"color": "#e1e0d9"}}, "gridlineStyle": "solid"}]
      }
    },
    "page": {
      "*": {
        "background": [{"color": {"solid": {"color": "#f9f9f7"}}, "transparency": 0}],
        "outspace": [{"color": {"solid": {"color": "#f9f9f7"}}}]
      }
    },
    "card": {
      "*": {
        "categoryLabels": [{"show": false}],
        "border": [{"show": true, "color": {"solid": {"color": "#e1e0d9"}}, "radius": 8}]
      }
    },
    "slicer": {
      "*": {
        "header": [{"show": false}]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{"strokeWidth": 2}]
      }
    }
  }
}
